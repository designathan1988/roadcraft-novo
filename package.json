{
  "name": "roadcraft",
  "private": true,
  "version": "5.0.0",
  "description": "Roadcraft: jogo de construir cidades grandes no navegador",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "arch": "node tools/arch-audit.mjs",
    "arch:check": "node tools/arch-audit.mjs --check tools/arch-baseline.json",
    "state:check": "node tools/state-check.mjs",
    "copy:check": "node tools/copy-check.mjs",
    "start": "vite build && node tools/serve.mjs",
    "test": "node --test test/*.test.ts",
    "shaders": "node tools/shadercheck/check.mjs ./mats.mjs && node tools/shadercheck/check.mjs --which=glsl ./mats.mjs",
    "electron": "vite build && electron .",
    "shot": "vite build && node tools/shot.mjs",
    "package:win": "vite build && node tools/package.mjs win32",
    "package:linux": "vite build && node tools/package.mjs linux",
    "budget": "node tools/budget.mjs",
    "fotos": "node tools/fotos.mjs",
    "cook:people": "node tools/cook-people.mjs",
    "icon": "node tools/make-icon.mjs",
    "package:web": "vite build && node tools/package-web.mjs",
    "photos:package": "node tools/photos/package.mjs",
    "photos:browser": "node tools/photos/package.mjs --browser"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^44.7.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "author": "Roadcraft",
  "productName": "Roadcraft"
}
